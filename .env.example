# --- Instagram login (use a secondary account if you can: private-API use risks the login account) ---
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
# Optional: base32 TOTP secret if the account uses an authenticator app for 2FA
IG_TOTP_SECRET=

# --- Who to watch (comma-separated, without @) ---
TARGET_USERNAMES=friend_username

# --- Scheduling ---
# Minutes between checks. Keep this high (>= 180) to avoid rate limits / bans.
CHECK_INTERVAL_MINUTES=360
# Random +/- percentage applied to the interval so requests don't look robotic.
INTERVAL_JITTER_PERCENT=20

# --- Safety ---
# If a fetched list is smaller than this % of the count Instagram reports,
# the fetch is treated as incomplete and no changes are reported for it.
MIN_FETCH_COMPLETENESS_PERCENT=90
# Skip targets with more followers/following than this (huge lists = many requests = ban risk).
MAX_LIST_SIZE=5000

# --- Optional proxy, e.g. http://user:pass@host:port ---
IG_PROXY=

# --- Optional Telegram notifications (create a bot with @BotFather, get chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DATA_DIR=data
